.env
.env.*
!.env.auth.example
!.env.production.example
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
node_modules/
*.log

# Docker entrypoint symlink/junction — recreated at container start
auth/public/api

# Archived / one-off scripts kept locally only
unused/

# Level solve JSON trees — distribute via solves.zip instead
solves/
!solves.zip

# Solver enumeration output — see tools/data/solver-runs/README.txt
tools/data/solver-runs/*
!tools/data/solver-runs/.gitkeep
!tools/data/solver-runs/README.txt

# Production game bundles (built by scripts/build-game-bundle.ps1)
deploy-export/

# Per-user progress JSON (server-side saves)
data/progress/users/
