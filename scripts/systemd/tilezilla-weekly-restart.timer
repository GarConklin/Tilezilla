[Unit]
Description=Run Tilezilla soft restart every Wednesday morning
Documentation=file:///opt/tilezilla/Docs/deploy-ubuntu.md

[Timer]
# Local VPS timezone — Wednesday 03:00
OnCalendar=Wed *-*-* 03:00:00
Persistent=true
RandomizedDelaySec=5m
Unit=tilezilla-weekly-restart.service

[Install]
WantedBy=timers.target
